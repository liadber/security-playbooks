PORT=4000
MONGODB_URI=mongodb://localhost:27017/playbooks
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Send the auth cookie only over HTTPS. Set to true in production; false for local http.
COOKIE_SECURE=false
